<?xml version="1.0" encoding="UTF-8"?>
<mei xmlns="http://www.music-encoding.org/ns/mei" meiversion="5.1">
  <meiHead><fileDesc><titleStmt><title>6C4C2 C7 second-layer leading clef stays inline</title></titleStmt><pubStmt/></fileDesc></meiHead>
  <music><body><mdiv n="1"><score>
    <scoreDef><staffGrp>
      <staffDef n="1" lines="5" notationtype="mensural.black"><clef shape="C" line="2"/></staffDef>
    </staffGrp></scoreDef>
    <section xml:id="s1">
      <staff n="1">
        <layer n="1">
          <note xml:id="pre-l1" dur="brevis" oct="4" pname="g"/>
        </layer>
        <layer n="2">
          <note xml:id="pre-l2" dur="brevis" oct="3" pname="c"/>
        </layer>
      </staff>
    </section>
    <sb xml:id="sb1"/>
    <section xml:id="s2">
      <staff n="1">
        <layer n="1">
          <note xml:id="post-l1" dur="brevis" oct="4" pname="a"/>
        </layer>
        <layer n="2">
          <clef xml:id="layer2-c1" shape="C" line="1"/>
          <note xml:id="post-l2" dur="brevis" oct="3" pname="e"/>
        </layer>
      </staff>
    </section>
  </score></mdiv></body></music>
</mei>
